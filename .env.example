# Plantilla de credenciales para las pruebas de navegador.
# Copiá a .env.local y completá. .env.local NO se commitea.
#
# Ojo con los requisitos de cada rol:
#   - el DUEÑO tiene que coincidir con ADMIN_UID de src/config.js;
#     registrarse NO alcanza para ser dueño.
#   - el BARBERO se registra como cliente y después el dueño lo promueve
#     desde el panel ("Hacer barbero").
#   - el CLIENTE tiene que verificar el email para poder reservar.

# --- CLIENTE (registro normal + verificar email) ---
CLIENTE_EMAIL=aguscolegio203@gmail.com
CLIENTE_PASSWORD=Agus203.

# --- BARBERO (registro normal, después el dueño lo promueve) ---
BARBERO_EMAIL=clashroyale.c140@gmail.com
BARBERO_PASSWORD=Agus203.

# --- DUEÑO (tiene que coincidir con ADMIN_UID) ---
DUENO_EMAIL=agus203.i.c@gmail.com
DUENO_PASSWORD=Agus203.